# ── 데이터 소스 ──────────────────────────────────────────────
# mock: 샘플 데이터(기본) | molit: 국토부 실거래가 API (연동 후 활성화)
NEXT_PUBLIC_DATA_SOURCE=mock

# 국토부 실거래가 공공데이터 API (https://www.data.go.kr) — 서버 전용 키
#   data.go.kr 활용신청: 아파트 매매 상세 / 단독·다가구 매매 / (연립·다세대 매매)
#   이 값은 서버 라우트(src/app/api/transactions)에서만 읽는다 — NEXT_PUBLIC_ 을 붙이지 말 것.
MOLIT_API_KEY=

# 정비사업 정보몽땅 (https://www.eum.go.kr) — 정비사업 단계·비례율 연동
EUM_API_KEY=

# ── Supabase (배포 시 입력) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 지도 ────────────────────────────────────────────────────────────────
# 기본 지도 엔진은 카카오맵 JS SDK. 아래 JavaScript 키가 없거나 SDK가 안 뜨면
# 자동으로 Leaflet + OpenStreetMap 지도로 폴백한다(지도가 비지 않게).
#
# 카카오 Developers → 내 애플리케이션 → 플랫폼 키 → **JavaScript 키**
#   · 반드시 JavaScript 키(웹 공개 키). Admin 키·REST 키를 넣으면 401 로 뜨지 않는다.
#   · 플랫폼 → Web → 사이트 도메인에 배포 도메인과 로컬 개발 주소를 등록해야 한다
#     예: https://redev-platform-iota.vercel.app , http://localhost:3100
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# VWorld WMTS 키 (scripts/README-gis.md 참고)
VWORLD_API_KEY=
