# ── 데이터 소스 ──────────────────────────────────────────────
# mock: 샘플 데이터(기본) | molit: 국토부 실거래가 API (연동 후 활성화)
NEXT_PUBLIC_DATA_SOURCE=mock

# 국토부 실거래가 공공데이터 API (https://www.data.go.kr)
MOLIT_API_KEY=
MOLIT_BASE_URL=https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade

# 정비사업 정보몽땅 (https://www.eum.go.kr) — 정비사업 단계·비례율 연동
EUM_API_KEY=

# ── Supabase (배포 시 입력) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 지도 (기본: 키 불필요한 OpenStreetMap 타일, 선택: VWorld·카카오) ──
# VWorld WMTS 키 (scripts/README-gis.md 참고)
VWORLD_API_KEY=
# 카카오맵 JS SDK 키로 교체 시
KAKAO_MAP_API_KEY=
